  "item": [
    {
      "name": "1. Delhi - overlaps deduped, cheapest wins",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('is array', () => pm.expect(body).to.be.an('array').that.is.not.empty);",
              "pm.test('no duplicate names', () => { const n = body.map(h => h.name.trim().toLowerCase()); pm.expect(new Set(n).size).to.eql(n.length); });",
              "pm.test('response shape', () => body.forEach(h => pm.expect(h).to.have.all.keys('name', 'price', 'supplier', 'commissionPct')));",
              "pm.test('sorted by price asc', () => { for (let i = 1; i < body.length; i++) pm.expect(body[i].price).to.be.at.least(body[i-1].price); });",
              "const byName = Object.fromEntries(body.map(h => [h.name.trim().toLowerCase(), h]));",
              "pm.test('overlapping hotels have the cheaper price', () => {",
              "  pm.expect(byName['taj palace'].price).to.eql(9500);",
              "  pm.expect(byName['taj palace'].supplier).to.eql('Supplier A');",
              "  pm.expect(byName['hotel sunshine'].price).to.eql(3200);",
              "  pm.expect(byName['the leela'].price).to.eql(10500);",
              "  pm.expect(byName['the leela'].supplier).to.eql('Supplier B');",
              "  pm.expect(byName['royal orchid'].price).to.eql(5800);",
              "});",
              "pm.test('exact price tie resolved by higher commission', () => {",
              "  pm.expect(byName['lotus residency'].price).to.eql(5500);",
              "  pm.expect(byName['lotus residency'].supplier).to.eql('Supplier B');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/hotels?city=delhi",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "hotels"
          ],
          "query": [
            {
              "key": "city",
              "value": "delhi"
            }
          ]
        }
      }
    },
